{
  "name": "@openclaw/windows-electron",
  "private": true,
  "version": "0.0.1",
  "description": "Windows-first Electron shell for OpenClaw gateway orchestration",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-renderer-assets.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm build && electron .",
    "smoke:owner": "powershell -ExecutionPolicy Bypass -File ./scripts/smoke-owner.ps1",
    "start": "electron .",
    "test": "node --test \"dist/main/ipc/validate.test.js\" \"dist/main/service/daemon-status.test.js\""
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "electron": "^37.2.6",
    "typescript": "^5.9.3"
  }
}
